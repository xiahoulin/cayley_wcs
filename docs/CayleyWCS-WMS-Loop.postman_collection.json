{
  "info": {
    "name": "CayleyWCS - WMS 下发闭环",
    "description": "对接应用使用应用凭据获取access_token，开放接口统一使用公共JSON封装。管理端登录仅用于准备应用和设备。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:20021"
    },
    {
      "key": "admin_user",
      "value": "admin"
    },
    {
      "key": "admin_pwd",
      "value": "1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "appId",
      "value": ""
    },
    {
      "key": "app_key",
      "value": ""
    },
    {
      "key": "app_secret",
      "value": ""
    },
    {
      "key": "taskNo",
      "value": ""
    },
    {
      "key": "app_id",
      "value": ""
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "request_id",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const path = pm.request.url.getPath();",
          "if (path && path.indexOf('/open/') === 0) {",
          "  pm.collectionVariables.set('request_id', pm.variables.replaceIn('{{$guid}}'));",
          "  if (path === '/open/task/dispatch' && !pm.collectionVariables.get('taskNo')) {",
          "    pm.collectionVariables.set('taskNo', 'PT' + (Date.now() % 65534 + 1));",
          "  }",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. 登录 (JWT，仅用于管理端准备)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('login ok', () => pm.expect(pm.response.json().isSuccess).to.be.true);",
              "pm.collectionVariables.set('token', pm.response.json().data.access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_name\": \"{{admin_user}}\",\n  \"password\": \"{{admin_pwd}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "login"
          ]
        }
      }
    },
    {
      "name": "2. 获取调用方应用凭据和目标设备ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const apps = pm.response.json().data;",
              "const caller = apps.find(x => x.app_code === 'WMS-MAIN');",
              "const device = apps.find(x => x.app_code === 'PALLET_SIM');",
              "pm.test('caller and device exist', () => {pm.expect(caller).to.not.be.undefined; pm.expect(device).to.not.be.undefined;});",
              "if (caller && device) {",
              "  pm.collectionVariables.set('app_id', String(caller.id));",
              "  pm.collectionVariables.set('app_key', caller.app_key);",
              "  pm.collectionVariables.set('app_secret', caller.app_secret);",
              "  pm.collectionVariables.set('appId', device.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": {
          "raw": "{{base_url}}/application/all",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "application",
            "all"
          ]
        }
      }
    },
    {
      "name": "3. 获取应用access_token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"app_id\":\"{{app_id}}\",\n  \"app_key\":\"{{app_key}}\",\n  \"app_secret\":\"{{app_secret}}\",\n  \"grant_type\":\"client_credentials\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/system/token",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "system",
            "token"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const d = pm.response.json();",
              "pm.test('token issued', () => pm.expect(d.errcode).to.eql(0));",
              "pm.collectionVariables.set('access_token', d.data.access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "4. 建立连接 (JWT) -> 期望 RUNNING",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const d = pm.response.json();",
              "pm.test('connection RUNNING', () => pm.expect(d.data.state).to.eql('RUNNING'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": {{appId}}\n}"
        },
        "url": {
          "raw": "{{base_url}}/connection/open",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "connection",
            "open"
          ]
        }
      }
    },
    {
      "name": "5. 下发任务 (应用令牌)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const d = pm.response.json();",
              "pm.test('dispatch ok', () => pm.expect(d.errcode).to.eql(0));",
              "console.log('task id=' + d.data.id + ' status=' + d.data.status + ' step=' + d.data.handshake_step);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"app_id\": \"{{app_id}}\",\n  \"app_key\": \"{{app_key}}\",\n  \"access_token\": \"{{access_token}}\",\n  \"request_id\": \"{{request_id}}\",\n  \"data\": {\n    \"appId\": {{appId}},\n    \"taskNo\": \"{{taskNo}}\",\n    \"priority\": 0,\n    \"wmsRef\": \"SO-DEMO\",\n    \"payload\": {\n      \"cmd_TaskType\": 1,\n      \"cmd_TakeCoor_Row\": 0,\n      \"cmd_TakeCoor_Column\": 0,\n      \"cmd_TakeCoor_Floor\": 0,\n      \"cmd_PutCoor_Row\": 1,\n      \"cmd_PutCoor_Column\": 2,\n      \"cmd_PutCoor_Floor\": 1,\n      \"cmd_PortNum\": 1\n    }\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/open/task/dispatch",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "open",
            "task",
            "dispatch"
          ]
        },
        "description": "前置：发布完整HTTP上位和OPC UA堆垛机协议、应用固定发布版本、绑定匹配通过。全部设备业务点位在data.payload，旧平铺字段返回4241。相同任务号与内容重试返回原任务，内容不同返回409。"
      }
    },
    {
      "name": "6. 对账查询 (应用令牌，反复点直到 completed)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const d = pm.response.json().data;",
              "const no = pm.collectionVariables.get('taskNo');",
              "const t = (d.rows || []).filter(x => x.task_no === no).pop();",
              "pm.test('task present', () => pm.expect(t).to.not.be.undefined);",
              "if (t) console.log('task ' + no + ' -> status=' + t.status + ' step=' + t.handshake_step + ' err=' + t.error_code);",
              "pm.test('completed (反复点直到通过)', () => pm.expect(t.status).to.eql('completed'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"app_id\":\"{{app_id}}\",\n  \"app_key\":\"{{app_key}}\",\n  \"access_token\":\"{{access_token}}\",\n  \"request_id\":\"{{request_id}}\",\n  \"data\":{\n  \"appId\": {{appId}},\n  \"sinceMillis\": 0,\n  \"limit\": 20\n}\n}"
        },
        "url": {
          "raw": "{{base_url}}/open/task/query",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "open",
            "task",
            "query"
          ]
        }
      }
    },
    {
      "name": "7. 断线重同步 snapshot (应用令牌，可选)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"app_id\":\"{{app_id}}\",\n  \"app_key\":\"{{app_key}}\",\n  \"access_token\":\"{{access_token}}\",\n  \"request_id\":\"{{request_id}}\",\n  \"data\":{\n  \"appId\": {{appId}}\n}\n}"
        },
        "url": {
          "raw": "{{base_url}}/open/snapshot",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "open",
            "snapshot"
          ]
        }
      }
    }
  ]
}
